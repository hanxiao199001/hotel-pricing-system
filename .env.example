# 酒店智能调价系统 - 环境变量示例
# 复制为 .env 并填入真实值。.env 已被 .gitignore 忽略，切勿提交真实凭据。

# ---------------------------------------------------------------------------
# 数据来源
#   mock = 内置模拟数据（默认，开发/测试用，不需要任何真实账号）
#   real = 调用携程采集脚本抓取真实 OTA 数据
# ---------------------------------------------------------------------------
DATA_SOURCE=mock

# ---------------------------------------------------------------------------
# mock 模式必填：携程账号三件套（模拟模式只校验非空）
# ---------------------------------------------------------------------------
CTRIP_USERNAME=your_ctrip_username
CTRIP_PASSWORD=your_ctrip_password
CTRIP_HOTEL_ID=your_hotel_id

# ---------------------------------------------------------------------------
# real 模式必填：自家酒店名称/城市（用于定位周边竞品）
# 当前价与入住率不再人工配置：由 eBooking 经营数据采集提供
#   当前价 = eBook 今日「非钟点房」最低整晚房型价
#   入住率 = eBook 实时 occupancyRate
# 使用前先跑一次 ebook_collector.py / 中台「采集经营数据」。
# ---------------------------------------------------------------------------
MY_HOTEL_NAME=君华海逸酒店
MY_HOTEL_CITY=海口
# MY_HOTEL_ROOMS_TOTAL=50

# 竞品搜索半径（公里）
COMPETITOR_DISTANCE_KM=2

# ---------------------------------------------------------------------------
# real 模式的采集环境（默认值已按本机适配，通常无需修改）
# 采集脚本依赖 playwright，必须使用独立的 venv 解释器
# ---------------------------------------------------------------------------
# CTRIP_SCRAPER_SCRIPT=D:\TeleAgentWrork\酒店AI\ctrip_hotel_scraper.py
# SCRAPER_PYTHON=D:\TeleAgentWrork\酒店AI\.venv\Scripts\python.exe

# ★ 这个 profile 必须处于「已登录携程」状态，否则采不到任何价格：
#   未登录时携程列表页只显示「登录以查看会员价」，价格元素是空 div，
#   脚本仍能采到酒店名和房型，但 price 全为 0，会被校验层整批拒绝。
#   profiles/default 是采集脚本的默认目录，已登录，可直接复用。
#   换成全新目录后，需先用有头浏览器打开该目录并手动登录携程一次。
# SCRAPER_PROFILE=D:\TeleAgentWrork\酒店AI\profiles\default

# SCRAPER_CHANNEL=edge
# SCRAPER_COLLECT_ROOMS=false
# SCRAPER_LOGIN_WAIT=60
# SCRAPER_TIMEOUT=900

# ---------------------------------------------------------------------------
# 通知。NOTIFY_ENABLED 默认为 true；为 true 时 NOTIFY_RECIPIENT 必填。
# 不需要通知时设为 false，此时可以不填接收人。
# ---------------------------------------------------------------------------
NOTIFY_ENABLED=true
NOTIFY_RECIPIENT=+8613800000000

# SQLite 数据库路径（可选）
# 留空/注释掉即使用项目目录下的 pricing.db。
# 若要指定，必须写成真实存在的目录，别照抄示例路径。
# PRICING_DB_PATH=D:/data/pricing.db

# ---------------------------------------------------------------------------
# 点评（口碑分析 / 差评预警）
# 由 ctrip_hotel_reviews.py 采集产出，写在项目内 data/reviews/ 下；
# 还没有采集过时自动读 REVIEWS_LEGACY_JSON 指向的历史快照。
# 文件都不存在时这两页退回「示例数据」，不会报错。
# ---------------------------------------------------------------------------
# REVIEWS_JSON=D:\TeleAgentWrork\酒店AI\hotel-pricing-system\data\reviews\ctrip_reviews.json
# REVIEWS_LEGACY_JSON=D:\TeleAgentWrork\酒店AI\ctrip_hotel_reviews.json

# 采集脚本与参数（默认值已按本机适配，通常无需修改）
# REVIEWS_SCRIPT=D:\TeleAgentWrork\酒店AI\ctrip_hotel_reviews.py
# REVIEWS_LOGIN_WAIT=180      # 登录/滑块人工处理等待秒数
# REVIEWS_MAX_PAGES=220       # 翻页上限；pageSize=50 时约 40 页
# REVIEWS_TIMEOUT=1800        # 整个子进程的超时
# REVIEWS_ATTEMPTS=2          # 秒退（浏览器未释放）时自动重试次数
# REVIEWS_BEFORE_DAYS=1       # 只保留早于「今天+N 天」发表的点评
# REVIEWS_FULL_SYNC_DAYS=7    # 每 N 天做一次全量校准（清掉已删除点评）；<=0 关闭增量、每次全量
# REVIEWS_EXISTING_CONFIRM_PAGES=2  # 增量到达旧点评边界后，再冗余翻几页确认
# REVIEWS_FULL_SYNC_MIN_RATIO=0.5   # 全量校准采到的条数低于旧快照此比例则拒绝覆盖

# ---------------------------------------------------------------------------
# 携程 eBooking 商家后台 · 经营数据采集（可选，只读）
# 自动填充入住率/出租率/ADR/成交/各房型挂牌价与库存，把「经营报表」从示例变真实。
# 采集器只监听页面自然发出的只读接口，不主动重放、不写后台。
# ★ profile 需已登录 ebooking（在 SCRAPER_PROFILE 目录的有头浏览器里登录一次）。
# 未登录时脚本会等 login_wait 秒，给人手扫码/验证的窗口。
# ---------------------------------------------------------------------------
# EBOOK_SCRIPT=D:\TeleAgentWrork\酒店AI\hotel-pricing-system\ebook_collector.py
# EBOOK_JSON=D:\TeleAgentWrork\酒店AI\hotel-pricing-system\data\ebook\ctrip_ebook.json
# EBOOK_LOGIN_WAIT=180        # 登录/滑块人工处理等待秒数
# EBOOK_PAGE_WAIT=8           # 每个页面等接口返回的秒数
# EBOOK_TIMEOUT=600           # 整个子进程的超时
# EBOOK_ATTEMPTS=2            # 秒退（浏览器未释放）时自动重试次数

# ---------------------------------------------------------------------------
# 每日自动采集（中台内置，默认开启；实现见 webapp/daily.py，两时段采集链）
#   早链 DAILY_COLLECT_AT=09:00+R：竞品价格 → 经营数据 → 点评（+R = 该链含点评）
#   晚链 DAILY_COLLECT_AT2=16:00：竞品价格 → 经营数据（点评不采）
#   每链到点自动执行；到点之后当天首次进入中台会立即触发；
#   判重按「当天×时段」记录在 daily_collects 表，手动采集成功则当天两链都跳过该类；
#   DATA_SOURCE=mock 时自动跳过，避免把模拟数据写进真实库。
#   注意：自动采集会打开可见浏览器（Edge），依赖 profile 已登录携程。
# ---------------------------------------------------------------------------
# DAILY_COLLECT_ENABLED=true        # 总开关；false 时完全不启动监视线程
# DAILY_COLLECT_AT=09:00+R          # 早链时点（HH:MM 或 HH:MM+R，+R 表示该链含点评）
# DAILY_COLLECT_AT2=16:00           # 晚链时点（默认不含点评；不需要晚链留空会报错，可设 23:59 关闭）
# DAILY_COLLECT_MAX_ATTEMPTS=1      # 每时段最多自动尝试次数；1 = 失败该时段不重试
# DAILY_COLLECT_COOLDOWN_MINUTES=60 # 自动重试间隔（MAX_ATTEMPTS>1 时生效）
# DAILY_COLLECT_POLL_SECONDS=30     # 监视线程轮询间隔

# ---------------------------------------------------------------------------
# 房型口碑 → 定价参考（可选）
# 只影响「判断」，不影响算价。建议价永远由 PRICING_STRATEGY 决定。
# ---------------------------------------------------------------------------
# ROOM_MIN_SAMPLE=30            # 少于此点评数的档位不下结论
# ROOM_STRONG_RATIO=1.0         # 差评率 ≤ 整体×此值 → 口碑支撑强
# ROOM_WEAK_RATIO=2.0           # 差评率 ≥ 整体×此值 → 溢价承压
# ROOM_WINDOW_MONTHS=0          # 房型口碑统计窗口（自然月），0 = 全量；设 24 则只算最近 24 个月
# MY_HOTEL_BASE_ROOM_TIER=豪华客房   # 起价对应档位；留空自动取点评量最大的一档

# ---------------------------------------------------------------------------
# 大模型（可选，仅用于「差评回复」的自然语言生成）
#
# 三项都填齐才会启用；任何一项为空都会静默降级到模板，功能不受影响。
# 接口按 OpenAI 兼容格式（POST {base_url}/chat/completions）。
# 边界：只读一条点评文本 → 只返回回复正文；不参与算价、不写库、不碰价格。
# ---------------------------------------------------------------------------
# LLM_BASE_URL=https://api.example.com/v1
# LLM_API_KEY=sk-xxxxxxxx
# LLM_MODEL=your-model-name
# LLM_TIMEOUT=60
# LLM_MAX_TOKENS=700
# LLM_TEMPERATURE=0.4

# ---------------------------------------------------------------------------
# 点评归因的模型层（可选，与上面的回复草稿共用同一个 key）
#
# 分工：统计数字和「硬件 vs 服务」的归因仍由 reviews_analytics 算，
# 模型只做关键词表做不到的事——把差评聚成「一次整改动作能解决」的问题。
# 每条依据都要能对回点评原文，对不上的丢弃；没 key 时页面自动回退规则文案。
#
# 结果按 (快照路径, mtime, size, 模型名, prompt 版本) 缓存到 data/cache/。
# 同一份快照结论固定，不会刷一次页面变一次。
#
# 采集完想立刻生成（不等页面首次访问）：
#     python -m reviews_llm
# ---------------------------------------------------------------------------
# REVIEWS_LLM_ENABLED=true
# REVIEWS_LLM_CACHE=data/cache/reviews_llm.json
# REVIEWS_LLM_MAX_TOKENS=3000      # 1600 会在第四个问题时被截断，实测过
# REVIEWS_LLM_TEMPERATURE=0.2
# REVIEWS_LLM_TIMEOUT=25           # 页面首次生成是同步的，宁可这次不出结论也别卡死
# REVIEWS_LLM_MAX_SAMPLES=40       # 最多喂多少条差评原文
