# 酒店智能调价系统 - 环境变量示例
# 复制为 .env 并填入真实值。.env 已被 .gitignore 忽略，切勿提交真实凭据。

# ---------------------------------------------------------------------------
# 数据来源
#   mock = 内置模拟数据（默认，开发/测试用，不需要任何真实账号）
#   real = 调用携程采集脚本抓取真实 OTA 数据
# ---------------------------------------------------------------------------
DATA_SOURCE=mock

# ---------------------------------------------------------------------------
# mock 模式必填：携程账号三件套（模拟模式只校验非空）
# ---------------------------------------------------------------------------
CTRIP_USERNAME=your_ctrip_username
CTRIP_PASSWORD=your_ctrip_password
CTRIP_HOTEL_ID=your_hotel_id

# ---------------------------------------------------------------------------
# real 模式必填：自家酒店
# 入住率拿不到（属于 PMS/商家后台数据），必须人工提供，建议每天更新。
# 当前价格也建议人工填；采集结果里通常会包含自家酒店，但会按名称排除出竞品，
# 不做自动取值，避免名称匹配错误时把竞品价当成自己的价。
# ---------------------------------------------------------------------------
MY_HOTEL_NAME=君华海逸酒店
MY_HOTEL_CITY=海口
MY_HOTEL_CURRENT_PRICE=180
MY_HOTEL_OCCUPANCY_RATE=45
# MY_HOTEL_ROOMS_TOTAL=50

# 竞品搜索半径（公里）
COMPETITOR_DISTANCE_KM=2

# ---------------------------------------------------------------------------
# real 模式的采集环境（默认值已按本机适配，通常无需修改）
# 采集脚本依赖 playwright，必须使用独立的 venv 解释器
# ---------------------------------------------------------------------------
# CTRIP_SCRAPER_SCRIPT=D:\TeleAgentWrork\酒店AI\ctrip_hotel_scraper.py
# SCRAPER_PYTHON=D:\TeleAgentWrork\酒店AI\.venv\Scripts\python.exe

# ★ 这个 profile 必须处于「已登录携程」状态，否则采不到任何价格：
#   未登录时携程列表页只显示「登录以查看会员价」，价格元素是空 div，
#   脚本仍能采到酒店名和房型，但 price 全为 0，会被校验层整批拒绝。
#   profiles/default 是采集脚本的默认目录，已登录，可直接复用。
#   换成全新目录后，需先用有头浏览器打开该目录并手动登录携程一次。
# SCRAPER_PROFILE=D:\TeleAgentWrork\酒店AI\profiles\default

# SCRAPER_CHANNEL=edge
# SCRAPER_COLLECT_ROOMS=false
# SCRAPER_LOGIN_WAIT=60
# SCRAPER_TIMEOUT=900

# ---------------------------------------------------------------------------
# 通知。NOTIFY_ENABLED 默认为 true；为 true 时 NOTIFY_RECIPIENT 必填。
# 不需要通知时设为 false，此时可以不填接收人。
# ---------------------------------------------------------------------------
NOTIFY_ENABLED=true
NOTIFY_RECIPIENT=+8613800000000

# SQLite 数据库路径（可选）
# 留空/注释掉即使用项目目录下的 pricing.db。
# 若要指定，必须写成真实存在的目录，别照抄示例路径。
# PRICING_DB_PATH=D:/data/pricing.db

# ---------------------------------------------------------------------------
# 点评（口碑分析 / 差评预警）
# 由 ctrip_hotel_reviews.py 采集产出，写在项目内 data/reviews/ 下；
# 还没有采集过时自动读 REVIEWS_LEGACY_JSON 指向的历史快照。
# 文件都不存在时这两页退回「示例数据」，不会报错。
# ---------------------------------------------------------------------------
# REVIEWS_JSON=D:\TeleAgentWrork\酒店AI\hotel-pricing-system\data\reviews\ctrip_reviews.json
# REVIEWS_LEGACY_JSON=D:\TeleAgentWrork\酒店AI\ctrip_hotel_reviews.json

# 采集脚本与参数（默认值已按本机适配，通常无需修改）
# REVIEWS_SCRIPT=D:\TeleAgentWrork\酒店AI\ctrip_hotel_reviews.py
# REVIEWS_LOGIN_WAIT=180      # 登录/滑块人工处理等待秒数
# REVIEWS_MAX_PAGES=220       # 翻页上限；pageSize=50 时约 40 页
# REVIEWS_TIMEOUT=1800        # 整个子进程的超时
# REVIEWS_ATTEMPTS=2          # 秒退（浏览器未释放）时自动重试次数
# REVIEWS_BEFORE_DAYS=1       # 只保留早于「今天+N 天」发表的点评

# ---------------------------------------------------------------------------
# 房型口碑 → 定价参考（可选）
# 只影响「判断」，不影响算价。建议价永远由 PRICING_STRATEGY 决定。
# ---------------------------------------------------------------------------
# ROOM_MIN_SAMPLE=30            # 少于此点评数的档位不下结论
# ROOM_STRONG_RATIO=1.0         # 差评率 ≤ 整体×此值 → 口碑支撑强
# ROOM_WEAK_RATIO=2.0           # 差评率 ≥ 整体×此值 → 溢价承压
# MY_HOTEL_BASE_ROOM_TIER=豪华客房   # 起价对应档位；留空自动取点评量最大的一档

# ---------------------------------------------------------------------------
# 大模型（可选，仅用于「差评回复」的自然语言生成）
#
# 三项都填齐才会启用；任何一项为空都会静默降级到模板，功能不受影响。
# 接口按 OpenAI 兼容格式（POST {base_url}/chat/completions）。
# 边界：只读一条点评文本 → 只返回回复正文；不参与算价、不写库、不碰价格。
# ---------------------------------------------------------------------------
# LLM_BASE_URL=https://api.example.com/v1
# LLM_API_KEY=sk-xxxxxxxx
# LLM_MODEL=your-model-name
# LLM_TIMEOUT=60
# LLM_MAX_TOKENS=700
# LLM_TEMPERATURE=0.4
